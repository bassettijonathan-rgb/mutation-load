{
  "name": "mutation-load",
  "version": "1.0.0",
  "private": true,
  "description": "A browser simulation of mutation load: why harmful mutations in thousands of genes do not take over a population, played as a single-file page.",
  "type": "module",
  "scripts": {
    "build": "node tools/build-artifact.mjs",
    "build:quick": "node tools/build-artifact.mjs --quick",
    "build:wasm": "node tools/build-wasm.mjs",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:long": "node --test \"test/long/*.test.js\"",
    "test:browser": "node test/browser/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
